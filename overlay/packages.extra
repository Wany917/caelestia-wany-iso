# Paquets ajoutes au profil releng d'archiso.
# Concatenes a profile/packages.x86_64 par scripts/make-profile.fish.
#
# ATTENTION : pas de commentaire en fin de ligne. mkarchiso retire bien le "#..."
# (sed 's/#.*//') mais laisse les espaces qui precedent, et pacman rejette un nom
# de paquet avec des espaces en fin. Un commentaire = sa propre ligne.

# --- Desktop ---
# Le metapackage tire la chaine caelestia (hyprland, fish, foot, quickshell,
# caelestia-shell...). Il suppose un Arch deja equipe en son et Bluetooth : voir
# la section suivante.
caelestia-meta
# Helper AUR : install.fish le reclame par son nom exact (pacman -Q paru), et sans
# lui il tenterait de le compiler depuis l'AUR au premier boot.
paru

# --- Son et Bluetooth ---
# caelestia-meta ne tire que wireplumber, et pipewire seul n'a que son module
# video : aucune carte son (wpctl ne montre que la webcam), pas de son dans les
# navigateurs ni Discord, volume qui retombe a 0 (issue #3). pipewire-audio
# apporte les modules alsa et bluez5, pipewire-pulse les applications PulseAudio.
pipewire-audio
pipewire-alsa
pipewire-pulse
rtkit
# Mixeur ouvert par le bouton de reglages audio du shell (general.apps.audio dans
# le shell.json du rice) : le defaut de caelestia, pwvucontrol, n'est que dans l'AUR.
pavucontrol
# Sans bluez, pas de bluetoothd : le bouton du shell se recoupe aussitot. Son
# service est active par scripts/make-profile.fish. bluez-utils fournit aussi
# mpris-proxy, lance par le rice (touches media des casques).
bluez
bluez-utils

# --- Apps lancees par les keybinds du rice ---
# $browser, Super+W. MPL-2.0, donc redistribuable dans l'image.
zen-browser-bin
# $fileExplorer, Super+E, et explorateur par defaut du shell. gvfs : corbeille et
# cles USB dans Thunar. tumbler : vignettes.
thunar
gvfs
tumbler
# Lances au demarrage par execs.lua du rice : l'agent polkit (fenetres de mot de
# passe des applications graphiques) et le trousseau (mots de passe enregistres
# par le navigateur, Discord...).
polkit-gnome
gnome-keyring

# PAS d'editeur embarque. $editor vaut 'code' (Super+C), mais
# visual-studio-code-bin est sous licence 'custom: commercial' : la build
# Microsoft ne peut pas etre redistribuee dans une ISO publique. Le paquet AUR
# lui-meme la telecharge chez Microsoft a la compilation plutot que de l'heberger.
# L'utilisateur l'installe apres coup (paru est embarque) — voir le README.

# --- Pilotes graphiques ---
# Une ISO demarre sur du materiel inconnu : on couvre large plutot que de cibler
# la machine de build.
mesa
# Rendu logiciel : sans lui, pas d'affichage en machine virtuelle.
vulkan-swrast
vulkan-intel
vulkan-radeon
# NVIDIA recent, precompile pour le noyau stock.
nvidia-open

# --- Session ---
# Gestionnaire de session : autologin dans le live, et sur le systeme installe il
# lance start-hyprland (fourni par le paquet hyprland) apres l'ecran de login.
greetd
# Ecran de login du systeme installe (le live n'en a pas besoin)
greetd-tuigreet
networkmanager
xdg-desktop-portal-hyprland
qt6-wayland

# --- Polices ---
# Le rice affiche du CJK (titres de morceaux) et des emoji : sans ces polices ce
# sont des carres vides.
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
# Police par defaut de caelestia-shell 2.x (titres, texte, etiquettes), que le
# paquet ne declare pas : sans elle le shell retombe sur une police de
# remplacement. AUR, OFL-1.1, donc redistribuable.
ttf-google-sans-flex-variable

# --- Installation sur disque ---
archinstall
