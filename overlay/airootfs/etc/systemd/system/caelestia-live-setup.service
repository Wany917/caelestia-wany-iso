[Unit]
Description=Prepare la session live caelestia
# Doit finir avant greetd : il lance le bureau pour l'utilisateur que ce
# service cree, et applique le rice dans son home.
Before=greetd.service
After=local-fs.target
ConditionPathExists=/run/archiso/bootmnt

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/caelestia-live-setup
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
