#!/usr/bin/env bash
# Installe le systeme live sur un disque.
#
# On recopie le systeme live tel quel au lieu de refaire un pacstrap : l'image
# contient deja le bureau complet et ses paquets AUR, donc recopier evite d'embarquer
# un cache de plusieurs Go et rend l'installation reellement hors-ligne.
#
# ATTENTION : efface integralement le disque choisi.

set -euo pipefail

TARGET=/mnt

# --- affichage ---
c_red=$'\e[1;31m'; c_grn=$'\e[1;32m'; c_cyn=$'\e[1;36m'; c_yel=$'\e[1;33m'; c_off=$'\e[0m'
step() { printf '\n%s:: %s%s\n' "$c_cyn" "$1" "$c_off"; }
info() { printf '   %s\n' "$1"; }
warn() { printf '%s !! %s%s\n' "$c_yel" "$1" "$c_off"; }
die()  { printf '%s !! %s%s\n' "$c_red" "$1" "$c_off" >&2; exit 1; }

# --- garde-fous ---
[[ $EUID -eq 0 ]] || die "a lancer en root"
[[ -e /run/archiso/bootmnt ]] || die "a lancer depuis la session live caelestia-wany"
[[ -d /sys/firmware/efi ]] || die \
    "machine demarree en mode BIOS/CSM. Cet installeur ne pose que systemd-boot (UEFI).
   Redemarre en UEFI, ou installe un chargeur BIOS a la main."
mountpoint -q "$TARGET" && die "$TARGET est deja monte, demonte-le d'abord"

cat <<BANNER

  ${c_cyn}caelestia-wany${c_off} — installation sur disque

  Le bureau est ${c_cyn}caelestia${c_off} par soramanew et caelestia-dots.
  https://github.com/caelestia-dots

BANNER

# --- choix du disque ---
step 'Disque cible'
lsblk -dpno NAME,SIZE,MODEL -e 7,11 | sed 's/^/   /'
echo
read -rp '   Disque a effacer (ex: /dev/nvme0n1) : ' DISK
[[ -b $DISK ]] || die "$DISK n'est pas un peripherique bloc"

# Refuse le disque qui porte le live : ce serait scier la branche
if findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null | grep -q "^${DISK}"; then
    die "$DISK porte le support live, choisis un autre disque"
fi

echo
warn "TOUT le contenu de $DISK va etre detruit :"
lsblk -pno NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK" | sed 's/^/     /'
echo
read -rp "   Retape le chemin du disque pour confirmer : " CONFIRM
[[ $CONFIRM == "$DISK" ]] || die 'confirmation incorrecte, rien n a ete touche'

# --- parametres systeme ---
step 'Parametres'
read -rp '   Nom de machine [caelestia] : ' HOSTNAME; HOSTNAME=${HOSTNAME:-caelestia}
read -rp '   Utilisateur [jinshi] : ' USERNAME; USERNAME=${USERNAME:-jinshi}
read -rp '   Fuseau horaire [Europe/Paris] : ' TIMEZONE; TIMEZONE=${TIMEZONE:-Europe/Paris}
read -rp '   Locale [fr_FR.UTF-8] : ' LOCALE; LOCALE=${LOCALE:-fr_FR.UTF-8}
read -rp '   Clavier console [fr] : ' KEYMAP; KEYMAP=${KEYMAP:-fr}

[[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] || die "fuseau inconnu : $TIMEZONE"

while :; do
    read -rsp "   Mot de passe pour $USERNAME : " PASS1; echo
    read -rsp '   Confirme : ' PASS2; echo
    [[ -n $PASS1 && $PASS1 == "$PASS2" ]] && break
    warn 'mots de passe vides ou differents'
done

# --- partitionnement ---
step "Partitionnement de $DISK"
sgdisk -Z "$DISK" >/dev/null
sgdisk -n1:0:+1G -t1:ef00 -c1:EFI \
       -n2:0:0    -t2:8300 -c2:caelestia "$DISK" >/dev/null
partprobe "$DISK"; sleep 2

# nvme0n1 -> nvme0n1p1 ; sda -> sda1
if [[ $DISK =~ [0-9]$ ]]; then P="${DISK}p"; else P="$DISK"; fi
ESP="${P}1"; ROOT="${P}2"
[[ -b $ESP && -b $ROOT ]] || die 'partitions introuvables apres partitionnement'
info "ESP  $ESP"
info "root $ROOT"

step 'Formatage'
mkfs.fat -F32 -n EFI "$ESP" >/dev/null
mkfs.ext4 -F -L caelestia "$ROOT" >/dev/null

mount "$ROOT" "$TARGET"
mkdir -p "$TARGET/boot"
mount "$ESP" "$TARGET/boot"

# --- copie du systeme live ---
step 'Copie du systeme (quelques minutes)'
rsync -aAXH --info=progress2 \
    --exclude='/dev/*' --exclude='/proc/*' --exclude='/sys/*' \
    --exclude='/run/*'  --exclude='/tmp/*'  --exclude='/mnt/*' \
    --exclude='/media/*' --exclude='/lost+found' \
    / "$TARGET/"

# --- retrait des artefacts propres au live ---
step 'Nettoyage des specificites du live'
rm -rf \
    "$TARGET/etc/systemd/system/getty@tty1.service.d" \
    "$TARGET/etc/systemd/system/livecd-alsa-unmuter.service" \
    "$TARGET/etc/systemd/system/livecd-talk.service" \
    "$TARGET/etc/systemd/system/choose-mirror.service" \
    "$TARGET/etc/systemd/system/pacman-init.service" \
    "$TARGET/etc/systemd/system/etc-pacman.d-gnupg.mount" \
    "$TARGET/etc/systemd/system/caelestia-live-setup.service" \
    "$TARGET/etc/systemd/system/cloud-init.target.wants" \
    "$TARGET/etc/mkinitcpio.conf.d/archiso.conf" \
    "$TARGET/etc/ssh/sshd_config.d/10-archiso.conf" \
    "$TARGET/etc/systemd/resolved.conf.d/archiso.conf" \
    "$TARGET/root/.zlogin" "$TARGET/root/.automated_script.sh" \
    "$TARGET/usr/local/bin/choose-mirror" "$TARGET/usr/local/bin/Installation_guide" \
    "$TARGET/usr/local/bin/livecd-sound" "$TARGET/usr/local/bin/caelestia-live-setup"

# Liens 'wants' devenus orphelins (leurs unites viennent d'etre supprimees)
find "$TARGET/etc/systemd/system" -xtype l -delete 2>/dev/null || true

# --- fstab ---
step 'Table des systemes de fichiers'
genfstab -U "$TARGET" >> "$TARGET/etc/fstab"

# --- configuration dans le chroot ---
step 'Configuration du systeme'

# Le mot de passe passe par un fichier, jamais par le heredoc : un caractere
# special ($, ", backslash) y serait interprete et casserait le script.
install -m 600 /dev/null "$TARGET/root/.passwd-in"
printf '%s:%s\n' "$USERNAME" "$PASS1" > "$TARGET/root/.passwd-in"

arch-chroot "$TARGET" /bin/bash -euo pipefail <<CHROOT
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
hwclock --systohc

sed -i "s/^#\s*\($LOCALE\)/\1/" /etc/locale.gen
grep -q '^en_US.UTF-8' /etc/locale.gen || sed -i 's/^#\s*\(en_US.UTF-8\)/\1/' /etc/locale.gen
locale-gen >/dev/null
echo "LANG=$LOCALE" > /etc/locale.conf
echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf

echo "$HOSTNAME" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME.localdomain $HOSTNAME
HOSTS

# Utilisateur. Shell fish : c'est celui que configure le rice.
useradd -m -G wheel,audio,video,input,storage -s /usr/bin/fish "$USERNAME"
chpasswd < /root/.passwd-in
rm -f /root/.passwd-in
# Root sans mot de passe utilisable : on passe par sudo
passwd -l root >/dev/null
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# Session graphique : greetd lance start-hyprland (fourni par le paquet hyprland).
# Sans ca, le systeme installe demarre sur un TTY sans bureau.
mkdir -p /etc/greetd
cat > /etc/greetd/config.toml <<GREETD
[terminal]
vt = 1

[default_session]
command = "start-hyprland"
user = "$USERNAME"

[initial_session]
command = "start-hyprland"
user = "$USERNAME"
GREETD
systemctl enable greetd.service >/dev/null

# Reseau : le live tourne sous systemd-networkd + iwd, mais la barre de caelestia
# lit NetworkManager (nmcli). Sans ce basculement, l'indicateur reseau reste vide.
systemctl disable systemd-networkd.service systemd-networkd.socket iwd.service >/dev/null 2>&1 || true
systemctl enable NetworkManager.service >/dev/null

# Initramfs sans les hooks archiso (leur fichier de conf vient d'etre retire)
mkinitcpio -P >/dev/null 2>&1

# Chargeur d'amorcage
bootctl --esp-path=/boot install >/dev/null
ROOT_UUID=\$(findmnt -no UUID /)
mkdir -p /boot/loader/entries
cat > /boot/loader/loader.conf <<LOADER
default caelestia.conf
timeout 3
console-mode max
editor no
LOADER
cat > /boot/loader/entries/caelestia.conf <<ENTRY
title   caelestia-wany
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=UUID=\$ROOT_UUID rw quiet
ENTRY
cat > /boot/loader/entries/caelestia-fallback.conf <<ENTRY
title   caelestia-wany (fallback)
linux   /vmlinuz-linux
initrd  /initramfs-linux-fallback.img
options root=UUID=\$ROOT_UUID rw
ENTRY
CHROOT

# --- rice dans le home de l'utilisateur ---
step "Installation du rice pour $USERNAME"
mkdir -p "$TARGET/home/$USERNAME/.local/share"
rsync -a "$TARGET/root/.local/share/caelestia/" \
         "$TARGET/home/$USERNAME/.local/share/caelestia/"
rm -rf "$TARGET/root/.local/share/caelestia" "$TARGET/root/.config"
arch-chroot "$TARGET" /usr/local/bin/caelestia-apply-rice "/home/$USERNAME" "$USERNAME"

# --- fin ---
umount -R "$TARGET"
printf '\n%s:: Installation terminee%s\n' "$c_grn" "$c_off"
info "Redemarre, retire le support, connecte-toi en $USERNAME."
info 'Le bureau caelestia demarre depuis la session Hyprland.'
