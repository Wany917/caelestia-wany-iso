#!/usr/bin/env bash
# Installe le systeme live sur un disque.
#
# On recopie le systeme live tel quel au lieu de refaire un pacstrap : l'image
# contient deja le bureau complet et ses paquets AUR, donc recopier evite d'embarquer
# un cache de plusieurs Go et rend l'installation reellement hors-ligne.
#
# Interface en anglais : l'ISO est publique. Toutes les questions sont posees et
# validees AVANT de toucher au disque.
#
# ATTENTION : efface integralement le disque choisi.

set -euo pipefail

TARGET=/mnt
LIVE_HOME=/home/caelestia

# --- affichage ---
c_red=$'\e[1;31m'; c_grn=$'\e[1;32m'; c_cyn=$'\e[1;36m'; c_yel=$'\e[1;33m'; c_off=$'\e[0m'
step() { printf '\n%s:: %s%s\n' "$c_cyn" "$1" "$c_off"; }
info() { printf '   %s\n' "$1"; }
warn() { printf '%s !! %s%s\n' "$c_yel" "$1" "$c_off"; }
die()  { printf '%s !! %s%s\n' "$c_red" "$1" "$c_off" >&2; exit 1; }

# --- garde-fous ---
# /run/archiso et non /run/archiso/bootmnt : copytoram (actif par defaut sur une
# vraie machine) demonte et supprime bootmnt. Voir caelestia-live-setup.service.
[[ $EUID -eq 0 ]] || die 'run me as root: sudo caelestia-install'
[[ -d /run/archiso ]] || die 'run me from the caelestia-wany live session'
[[ -d /sys/firmware/efi ]] || die \
    "this machine booted in BIOS/CSM mode. The installer only sets up systemd-boot (UEFI).
   Reboot the USB stick in UEFI mode."
mountpoint -q "$TARGET" && die "$TARGET is already mounted, unmount it first"

# Le noyau, pris dans l'image et non sur le support de demarrage : avec copytoram
# ce dernier n'est plus monte. mkarchiso vide /boot, mais le paquet linux garde sa
# copie dans /usr/lib/modules. Verifie ici, avant d'effacer quoi que ce soit.
KERNEL="/usr/lib/modules/$(uname -r)/vmlinuz"
[[ -f $KERNEL ]] || die "kernel image not found: $KERNEL"
[[ -d $LIVE_HOME/.local/share/caelestia ]] || die "rice not found in $LIVE_HOME"

# Disques qui portent le support live. Avec copytoram il n'est plus monte : on le
# retrouve par l'UUID qu'archiso a cherche au demarrage. lsblk -s remonte jusqu'au
# disque physique, y compris a travers device-mapper (Ventoy).
live_disks() {
    local src uuid
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
    if [[ -z $src ]]; then
        uuid=$(sed -n 's/.*archisosearchuuid=\([^ ]*\).*/\1/p' /proc/cmdline)
        [[ -n $uuid && -e /dev/disk/by-uuid/$uuid ]] && src=$(readlink -f "/dev/disk/by-uuid/$uuid")
    fi
    [[ -n $src ]] || return 0
    lsblk -lnspo NAME,TYPE "$src" 2>/dev/null | awk '$2 == "disk" { print $1 }' | sort -u
}
mapfile -t LIVE_DISKS < <(live_disks)

# --- saisie ---
# Repose la question tant que la reponse est refusee : une faute de frappe ne doit
# pas obliger a tout recommencer.
ask() {
    local -n _ask_out=$1
    local prompt=$2 def=$3 check=$4 reply
    while :; do
        read -rp "   $prompt${def:+ [$def]}: " reply
        reply=${reply:-$def}
        [[ -n $reply ]] || continue
        if "$check" "$reply"; then
            _ask_out=$reply
            return
        fi
    done
}

valid_hostname() {
    [[ $1 =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] && return
    warn 'letters, digits and dashes only'; return 1
}
valid_username() {
    if [[ ! $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
        warn 'lowercase letters, digits, - and _ only, starting with a letter'; return 1
    fi
    # 'caelestia' est le compte du live : il est repris tel quel. Les autres
    # comptes existants sont des comptes systeme (root, greeter...).
    if [[ $1 != caelestia ]] && id -u "$1" &>/dev/null; then
        warn "$1 is a system account"; return 1
    fi
}
valid_timezone() {
    [[ $1 != /* && $1 != *..* && -f /usr/share/zoneinfo/$1 ]] && return
    warn 'unknown timezone (examples: UTC, Europe/Paris, America/New_York, Asia/Kolkata)'; return 1
}
valid_locale() {
    awk -v l="$1" '$1 == l { found = 1 } END { exit !found }' /usr/share/i18n/SUPPORTED && return
    warn 'unknown locale (examples: en_US.UTF-8, fr_FR.UTF-8, de_DE.UTF-8)'; return 1
}
valid_layout() {
    [[ $1 != */* && -f /usr/share/X11/xkb/symbols/$1 ]] && return
    warn 'unknown layout (examples: us, gb, fr, de, es, it, br)'; return 1
}
valid_disk() {
    local d l
    d=$(readlink -f "$1")
    [[ -b $d && $(lsblk -dno TYPE "$d" 2>/dev/null) == disk ]] || { warn "$1 is not a disk"; return 1; }
    for l in "${LIVE_DISKS[@]}"; do
        [[ $d == "$l" ]] && { warn "$1 holds the live system, pick another disk"; return 1; }
    done
    if lsblk -no MOUNTPOINTS "$d" | grep -q .; then
        warn "$1 has mounted partitions, unmount them first"; return 1
    fi
}

# Disposition XKB -> keymap de la console, quand les noms different. Sans
# equivalent, la console reste en us : seul le bureau compte vraiment.
console_keymap() {
    local k=$1
    case $k in
        gb) k=uk ;;
        br) k=br-abnt2 ;;
    esac
    if find /usr/share/kbd/keymaps -name "$k.map.gz" -print -quit | grep -q .; then
        echo "$k"
    else
        echo us
    fi
}

cat <<BANNER

  ${c_cyn}caelestia-wany${c_off}: install to disk

  The desktop is ${c_cyn}caelestia${c_off} by soramanew and the caelestia-dots team.
  https://github.com/caelestia-dots

  Nothing is written before the final confirmation. Ctrl+C aborts.

BANNER

step 'System settings'
ask HOSTNAME 'Hostname' caelestia valid_hostname
ask USERNAME 'Username' '' valid_username
ask TIMEZONE 'Timezone' UTC valid_timezone
ask LOCALE 'Locale' en_US.UTF-8 valid_locale
ask LAYOUT 'Keyboard layout' us valid_layout
KEYMAP=$(console_keymap "$LAYOUT")

while :; do
    read -rsp "   Password for $USERNAME: " PASS1; echo
    read -rsp '   Confirm: ' PASS2; echo
    [[ -n $PASS1 && $PASS1 == "$PASS2" ]] && break
    warn 'passwords are empty or do not match'
done

step 'Target disk'
lsblk -dpno NAME,SIZE,MODEL -e 7,11 | while read -r name rest; do
    mark=''
    for l in "${LIVE_DISKS[@]}"; do [[ $name == "$l" ]] && mark='   (live system)'; done
    printf '   %s %s%s\n' "$name" "$rest" "$mark"
done
echo
ask DISK 'Disk to ERASE (example: /dev/nvme0n1)' '' valid_disk
DISK=$(readlink -f "$DISK")

step 'Summary'
info "hostname   $HOSTNAME"
info "user       $USERNAME (sudo, fish)"
info "timezone   $TIMEZONE"
info "locale     $LOCALE"
info "keyboard   $LAYOUT (console: $KEYMAP)"
info "disk       $DISK, 1 GiB EFI + ext4 root"
echo
warn "EVERYTHING on $DISK will be destroyed:"
lsblk -pno NAME,SIZE,FSTYPE,LABEL "$DISK" | sed 's/^/     /'
echo
read -rp "   Type the disk path again to confirm: " CONFIRM
[[ $CONFIRM == "$DISK" ]] || die 'confirmation does not match, nothing was touched'

# A partir d'ici, un echec laisse le disque dans un etat intermediaire : on le dit.
trap 'printf "%s !! installation failed (line %s). %s is in an unknown state, mounts under %s are left for inspection.%s\n" "$c_red" "$LINENO" "$DISK" "$TARGET" "$c_off" >&2' ERR

# --- partitionnement ---
step "Partitioning $DISK"
sgdisk -Z "$DISK" >/dev/null
sgdisk -n1:0:+1G -t1:ef00 -c1:EFI \
       -n2:0:0    -t2:8300 -c2:caelestia "$DISK" >/dev/null
partprobe "$DISK"
udevadm settle

# nvme0n1 -> nvme0n1p1 ; sda -> sda1
if [[ $DISK =~ [0-9]$ ]]; then P="${DISK}p"; else P="$DISK"; fi
ESP="${P}1"; ROOT="${P}2"
[[ -b $ESP && -b $ROOT ]] || die 'partitions not found after partitioning'
info "ESP  $ESP"
info "root $ROOT"

step 'Formatting'
mkfs.fat -F32 -n EFI "$ESP" >/dev/null
mkfs.ext4 -F -L caelestia "$ROOT" >/dev/null

mount "$ROOT" "$TARGET"
mkdir -p "$TARGET/boot"
mount "$ESP" "$TARGET/boot"

# --- copie du systeme live ---
step 'Copying the system (a few minutes)'
rsync -aAXH --info=progress2 \
    --exclude='/dev/*' --exclude='/proc/*' --exclude='/sys/*' \
    --exclude='/run/*'  --exclude='/tmp/*'  --exclude='/mnt/*' \
    --exclude='/media/*' --exclude='/lost+found' \
    / "$TARGET/"

# --- retrait des artefacts propres au live ---
step 'Removing live-only pieces'
rm -rf \
    "$TARGET/etc/systemd/system/getty@tty1.service.d" \
    "$TARGET/etc/systemd/system/getty@tty1.service" \
    "$TARGET/etc/systemd/system/livecd-alsa-unmuter.service" \
    "$TARGET/etc/systemd/system/livecd-talk.service" \
    "$TARGET/etc/systemd/system/choose-mirror.service" \
    "$TARGET/etc/systemd/system/pacman-init.service" \
    "$TARGET/etc/systemd/system/etc-pacman.d-gnupg.mount" \
    "$TARGET/etc/systemd/system/caelestia-live-setup.service" \
    "$TARGET/etc/systemd/system/cloud-init.target.wants" \
    "$TARGET/etc/mkinitcpio.conf.d/archiso.conf" \
    "$TARGET/etc/ssh/sshd_config.d/10-archiso.conf" \
    "$TARGET/etc/systemd/resolved.conf.d/archiso.conf" \
    "$TARGET/etc/issue.d/caelestia-live.issue" \
    "$TARGET/root/.zlogin" "$TARGET/root/.automated_script.sh" \
    "$TARGET/usr/local/bin/choose-mirror" "$TARGET/usr/local/bin/Installation_guide" \
    "$TARGET/usr/local/bin/livecd-sound" "$TARGET/usr/local/bin/caelestia-live-setup" \
    "$TARGET/etc/sudoers.d/10-live" \
    "$TARGET/etc/sysusers.d/caelestia-live.conf"

# Liens 'wants' devenus orphelins (leurs unites viennent d'etre supprimees)
find "$TARGET/etc/systemd/system" -xtype l -delete 2>/dev/null || true

# Message d'accueil du live (installer, Wi-Fi via iwctl) : faux sur le systeme
# installe, qui tourne sous NetworkManager.
: > "$TARGET/etc/motd"

# --- noyau ---
# mkarchiso vide /boot de l'airootfs : copier le systeme live donne un /boot sans
# noyau, donc un systeme non amorcable. On le reprend dans /usr/lib/modules.
step 'Restoring the kernel'
install -Dm644 "$KERNEL" "$TARGET/boot/vmlinuz-linux"
info "vmlinuz-linux copied ($(du -h "$KERNEL" | cut -f1))"

# Le preset livre est celui d'archiso : il ne genere qu'une image 'archiso' liee
# a une config qu'on vient de supprimer, et aucune image de secours. On remet le
# preset standard d'Arch, qui produit default + fallback.
# Les microcodes sont embarques dans l'initramfs par le hook 'microcode' : pas
# d'image separee a prevoir dans les entrees de demarrage.
cat > "$TARGET/etc/mkinitcpio.d/linux.preset" <<'PRESET'
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default' 'fallback')

default_image="/boot/initramfs-linux.img"

fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
PRESET

# --- fstab ---
step 'Filesystem table'
genfstab -U "$TARGET" >> "$TARGET/etc/fstab"

# --- rice dans le home de l'utilisateur ---
# Copie AVANT le chroot : le compte live y est supprime, et avec lui la garantie
# que son home reste en place.
step "Installing the rice for $USERNAME"
mkdir -p "$TARGET/home/$USERNAME/.local/share"
if [[ $USERNAME != caelestia ]]; then
    rsync -a "$TARGET$LIVE_HOME/.local/share/caelestia/" \
             "$TARGET/home/$USERNAME/.local/share/caelestia/"
fi

# Reglages propres a cette machine, lus par hypr-user.lua du rice : le clavier
# choisi, et pas de verrouillage au demarrage puisque tuigreet vient deja de
# demander le mot de passe.
mkdir -p "$TARGET/home/$USERNAME/.config/caelestia"
cat > "$TARGET/home/$USERNAME/.config/caelestia/hypr-local.lua" <<LOCAL
-- Machine settings written by caelestia-install. Edit freely.
return {
    kb_layout     = "$LAYOUT",
    lock_on_start = false,
}
LOCAL

# --- configuration dans le chroot ---
step 'Configuring the system'

# Le mot de passe passe par un fichier, jamais par le heredoc : un caractere
# special ($, ", backslash) y serait interprete et casserait le script.
install -m 600 /dev/null "$TARGET/root/.passwd-in"
printf '%s:%s\n' "$USERNAME" "$PASS1" > "$TARGET/root/.passwd-in"

arch-chroot "$TARGET" /bin/bash -euo pipefail <<CHROOT
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
hwclock --systohc

sed -i "s/^#\s*\($LOCALE \)/\1/" /etc/locale.gen
grep -q '^en_US.UTF-8' /etc/locale.gen || sed -i 's/^#\s*\(en_US.UTF-8 \)/\1/' /etc/locale.gen
locale-gen >/dev/null
echo "LANG=$LOCALE" > /etc/locale.conf
echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf

echo "$HOSTNAME" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME.localdomain $HOSTNAME
HOSTS

# Utilisateur. Shell fish : c'est celui que configure le rice.
# Le compte 'caelestia' du live figure dans le /etc/passwd recopie. Choisi comme
# nom, on le reprend. Sinon on le supprime AVANT de creer le compte, qui recupere
# ainsi l'UID 1000. -f est indispensable : /proc dans le chroot est celui du live,
# ou ce compte fait tourner le bureau, et userdel refuserait (en silence, avant).
# Sans -r, son home reste : il est retire apres le chroot.
if [[ $USERNAME == caelestia ]]; then
    usermod -aG wheel,audio,video,input,storage -s /usr/bin/fish caelestia
else
    userdel -f caelestia
    useradd -M -d "/home/$USERNAME" -G wheel,audio,video,input,storage -s /usr/bin/fish "$USERNAME"
fi
chpasswd < /root/.passwd-in
rm -f /root/.passwd-in

# machine-id herite du live : deux machines installees depuis la meme image
# partageraient la meme identite (baux DHCP, journal, resolution de nom).
# Vide = systemd en regenere un au premier demarrage.
: > /etc/machine-id
# Root sans mot de passe utilisable : on passe par sudo
passwd -l root >/dev/null
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# Session graphique : ecran de login tuigreet, qui lance start-hyprland (fourni
# par le paquet hyprland) une fois le mot de passe accepte. Pas d'autologin : le
# live en a un, le systeme installe demande le mot de passe. L'utilisateur
# 'greeter' vient du paquet greetd.
mkdir -p /etc/greetd
cat > /etc/greetd/config.toml <<GREETD
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --asterisks --cmd start-hyprland"
user = "greeter"
GREETD
systemctl enable greetd.service >/dev/null

# Reseau : le live tourne sous systemd-networkd + iwd, mais la barre de caelestia
# lit NetworkManager (nmcli). Sans ce basculement, l'indicateur reseau reste vide.
systemctl disable systemd-networkd.service systemd-networkd.socket iwd.service >/dev/null 2>&1 || true
systemctl enable NetworkManager.service >/dev/null

# Initramfs sans les hooks archiso (leur fichier de conf vient d'etre retire)
mkinitcpio -P >/dev/null 2>&1

# Chargeur d'amorcage
bootctl --esp-path=/boot install >/dev/null
ROOT_UUID=\$(findmnt -no UUID /)
mkdir -p /boot/loader/entries
cat > /boot/loader/loader.conf <<LOADER
default caelestia.conf
timeout 3
console-mode max
editor no
LOADER
cat > /boot/loader/entries/caelestia.conf <<ENTRY
title   caelestia-wany
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=UUID=\$ROOT_UUID rw quiet
ENTRY
cat > /boot/loader/entries/caelestia-fallback.conf <<ENTRY
title   caelestia-wany (fallback)
linux   /vmlinuz-linux
initrd  /initramfs-linux-fallback.img
options root=UUID=\$ROOT_UUID rw
ENTRY
CHROOT

step 'Applying the rice'
arch-chroot "$TARGET" /usr/local/bin/caelestia-apply-rice "/home/$USERNAME" "$USERNAME"
# Mode par defaut d'Arch pour un home (HOME_MODE de login.defs)
chmod 700 "$TARGET/home/$USERNAME"

# Home du compte live, supprime dans le chroot : plus rien ne s'en sert.
if [[ $USERNAME != caelestia ]]; then
    rm -rf "$TARGET$LIVE_HOME"
fi

# --- fin ---
trap - ERR
umount -R "$TARGET"
printf '\n%s:: Installation complete%s\n' "$c_grn" "$c_off"
info 'Reboot, remove the USB stick, and log in as '"$USERNAME"'.'
info 'No network is needed: everything was copied from the live system.'
