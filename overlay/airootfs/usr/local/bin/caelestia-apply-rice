#!/usr/bin/env bash
# Pose le rice caelestia dans un home donne.
#
#   caelestia-apply-rice <home> [utilisateur]
#
# Utilise a deux endroits : la session live (home = /home/caelestia) et le systeme
# fraichement installe (home = /home/<user>, appele depuis le chroot). Un seul code
# pour les deux, sinon les deux chemins divergent des la premiere evolution du rice.
#
# On n'appelle pas install.fish : il installe des paquets et compile le metapackage,
# choses deja faites dans l'image et qui echoueraient sans reseau.

set -uo pipefail

HOME_DIR="${1:?usage: caelestia-apply-rice <home> [user]}"
OWNER="${2:-}"

RICE="$HOME_DIR/.local/share/caelestia"
CONFIG="$HOME_DIR/.config"

log() { echo "[rice] $*"; }

[[ -d $RICE ]] || { log "rice missing: $RICE"; exit 1; }

mkdir -p "$CONFIG"

# Un dossier de config genere par Hyprland lui-meme quand il ne trouve rien. Ce
# n'est PAS une config utilisateur a preserver, c'est un artefact a remplacer.
# Sans cette distinction, le garde-fou ci-dessous refusait de poser le rice et
# laissait Hyprland nu. Deux formats : l'ancien hyprland.conf ('autogenerated = 1')
# et le Lua depuis 0.56 ('AUTOGENERATED HYPRLAND CONFIG').
is_hypr_stub() {
    local d=$1
    [[ -d $d ]] || return 1
    grep -qs '^autogenerated' "$d/hyprland.conf" && return 0
    grep -qs 'AUTOGENERATED HYPRLAND CONFIG' "$d/hyprland.lua" && return 0
    return 1
}

# Memes cibles que les 'ln -s' d'install.fish. On ne remplace jamais un chemin
# existant qui ne serait pas deja un lien : ce serait ecraser la config de l'user.
for entry in hypr foot fish fastfetch btop uwsm starship.toml; do
    src="$RICE/$entry"
    dst="$CONFIG/$entry"
    [[ -e $src ]] || continue
    if [[ -e $dst && ! -L $dst ]]; then
        if is_hypr_stub "$dst"; then
            log "$dst is a stub generated by Hyprland, replacing it"
            rm -rf "$dst"
        else
            log "$dst exists and is not a link, leaving it alone"
            continue
        fi
    fi
    ln -sfn "$src" "$dst"
done
log "configs linked in $CONFIG"

# Overlay perso : overrides Hyprland, music-hud, patches du shell, setcap gsr.
# HOME doit etre positionne, le script s'en sert pour ses chemins de destination.
#
# On teste -f et non -x : mkarchiso copie l'airootfs avec --no-preserve=mode, donc
# le bit +x peut manquer. Le script est de toute facon invoque via 'fish', ce qui
# ne l'exige pas.
if [[ -f $RICE/custom/install-custom.fish ]]; then
    log 'applying the custom overlay'
    HOME="$HOME_DIR" fish "$RICE/custom/install-custom.fish" || log 'overlay failed (not fatal)'
fi

# Le scheme de couleurs doit exister avant le premier lancement du shell, sans quoi
# caelestia demarre sans palette.
if [[ ! -f $HOME_DIR/.local/state/caelestia/scheme.json ]]; then
    mkdir -p "$HOME_DIR/.local/state/caelestia"
    HOME="$HOME_DIR" caelestia scheme set -n shadotheme >/dev/null 2>&1 \
        || log 'default scheme not applied'
fi

# Le rice a pu etre copie en root : sans ca l'utilisateur ne peut rien ecrire.
if [[ -n $OWNER ]]; then
    chown -R "$OWNER:$OWNER" "$HOME_DIR"
    log "owner: $OWNER"
fi

log 'done'
