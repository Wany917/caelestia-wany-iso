#!/usr/bin/env bash
# Prepare la session live avant que greetd ne demarre le bureau.
#
# Hyprland REFUSE de tourner en root ("launched with superuser privileges").
# La session live a donc besoin d'un vrai utilisateur, ce qui rapproche au
# passage le live du systeme installe : les deux passent par greetd.
#
# L'utilisateur est cree au demarrage plutot que fige dans l'image : pas de
# /etc/shadow a maintenir a la main dans le depot.

set -uo pipefail

LIVE_USER=caelestia
LIVE_HOME="/home/$LIVE_USER"
STAMP=/run/caelestia-live-setup.done

log() { echo "[caelestia-live] $*"; }

[[ -e $STAMP ]] && { log 'deja fait'; exit 0; }

if ! id "$LIVE_USER" &>/dev/null; then
    # -M : le home est deja dans l'image (le rice y est embarque)
    useradd -M -d "$LIVE_HOME" -s /usr/bin/fish \
        -G wheel,audio,video,input,storage,seat "$LIVE_USER"
    # Session live : pas de mot de passe a saisir
    passwd -d "$LIVE_USER" >/dev/null
    log "utilisateur $LIVE_USER cree"
fi

mkdir -p "$LIVE_HOME"
chown "$LIVE_USER:$LIVE_USER" "$LIVE_HOME"

/usr/local/bin/caelestia-apply-rice "$LIVE_HOME" "$LIVE_USER"

touch "$STAMP"
log 'session prete'
