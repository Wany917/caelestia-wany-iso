#!/usr/bin/env bash
# Applique le rice dans la session live.
#
# L'utilisateur n'est PLUS cree ici : c'est systemd-sysusers qui s'en charge
# (/etc/sysusers.d/caelestia-live.conf), dans sysinit.target, donc bien avant
# greetd. Le creer ici reposait sur un simple Before=greetd.service, ce qui a
# suffi en machine virtuelle mais pas sur une machine reelle : greetd a boucle
# sur "configured default session user 'caelestia' not found" jusqu'a abandonner.
#
# Ce service ne fait donc plus que la mise en place du rice. Meme s'il echoue,
# la session ouvre : l'utilisateur existe de toute facon.

set -uo pipefail

LIVE_USER=caelestia
LIVE_HOME="/home/$LIVE_USER"
STAMP=/run/caelestia-live-setup.done

log() { echo "[caelestia-live] $*"; }

[[ -e $STAMP ]] && { log 'deja fait'; exit 0; }

# Filet de securite : si sysusers n'a pas fait son office, on ne laisse pas
# greetd boucler dans le vide.
if ! id "$LIVE_USER" &>/dev/null; then
    log "ATTENTION : $LIVE_USER absent alors que sysusers aurait du le creer"
    useradd -M -d "$LIVE_HOME" -s /usr/bin/fish \
        -G wheel,audio,video,input,storage,seat "$LIVE_USER" \
        || log "creation de secours en echec"
fi

# Session live : aucun mot de passe a saisir.
passwd -d "$LIVE_USER" >/dev/null 2>&1 || true

mkdir -p "$LIVE_HOME"
chown "$LIVE_USER:$LIVE_USER" "$LIVE_HOME"

/usr/local/bin/caelestia-apply-rice "$LIVE_HOME" "$LIVE_USER"

touch "$STAMP"
log 'session prete'
