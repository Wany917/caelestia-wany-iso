#!/usr/bin/env bash
# Applique le rice dans la session live.
#
# L'utilisateur est cree par systemd-sysusers (/etc/sysusers.d/caelestia-live.conf)
# et son home lui appartient des la construction de l'image (file_permissions
# dans profiledef.sh). Ce service ne fait que la mise en place du rice et retire
# le mot de passe : meme s'il echoue, greetd ouvre la session.
#
# Historique : en aout, les echecs sur materiel reel ont ete pris pour une course
# avec greetd. La vraie cause etait la condition du service sur
# /run/archiso/bootmnt, que copytoram supprime : il ne tournait jamais.

set -uo pipefail

LIVE_USER=caelestia
LIVE_HOME="/home/$LIVE_USER"
STAMP=/run/caelestia-live-setup.done

log() { echo "[caelestia-live] $*"; }

[[ -e $STAMP ]] && { log 'already done'; exit 0; }

# Filet de securite : si sysusers n'a pas fait son office, on ne laisse pas
# greetd boucler dans le vide.
if ! id "$LIVE_USER" &>/dev/null; then
    log "WARNING: $LIVE_USER missing, sysusers should have created it"
    useradd -M -d "$LIVE_HOME" -s /usr/bin/fish \
        -G wheel,audio,video,input,storage,seat "$LIVE_USER" \
        || log 'fallback user creation failed'
fi

# Session live : aucun mot de passe a saisir (login TTY, ecran de verrouillage,
# invites polkit). sysusers cree le compte verrouille ('!*').
passwd -d "$LIVE_USER" >/dev/null 2>&1 || true

mkdir -p "$LIVE_HOME"
chown "$LIVE_USER:$LIVE_USER" "$LIVE_HOME"

/usr/local/bin/caelestia-apply-rice "$LIVE_HOME" "$LIVE_USER"

# Entree "AZERTY / FR" du menu de demarrage : fr d'abord, us sur Verr. Maj.
# L'image est construite en us,fr (scripts/make-profile.fish).
if [[ " $(</proc/cmdline) " == *" caelestia.kb=fr "* ]]; then
    sed -i 's/kb_layout *= *"us,fr"/kb_layout     = "fr,us"/' "$LIVE_HOME/.config/caelestia/hypr-local.lua" \
        && log 'keyboard: fr (us on Caps Lock)'
fi

touch "$STAMP"
log 'live session ready'
