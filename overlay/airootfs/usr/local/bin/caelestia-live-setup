#!/usr/bin/env bash
# Met en place le rice caelestia dans la session live, une fois au demarrage.
#
# Simple enveloppe autour de caelestia-apply-rice : la mise en place est identique
# entre le live et le systeme installe, seul le home change.

set -uo pipefail

STAMP="/run/caelestia-live-setup.done"

[[ -e $STAMP ]] && { echo "[caelestia-live] deja fait"; exit 0; }

/usr/local/bin/caelestia-apply-rice /root

touch "$STAMP"
