# Depot pacman local : ~70 Mo de binaires regeneres par scripts/build-aur-repo.fish.
# Des binaires dans git gonflent l'historique pour toujours, et quickshell-git seul
# pese 67 Mo (au-dessus du seuil d'avertissement GitHub).
/local-repo/

# Sorties de mkarchiso
/out/
/work/

# Profil archiso : entierement regenere par scripts/make-profile.fish.
# Seul overlay/ est versionne, pour garder notre diff avec releng explicite.
/profile/

# Disques et variables UEFI des VM de test (gros, jetables)
/vm/

# Morceaux de l ISO prepares pour une release (regeneres par make-release.fish)
/release/

# Brouillons personnels (message a l amont deja poste : discussions #1842 de
# caelestia-dots/shell). Rien a faire dans un depot public.
/message-to-soramanew.md
